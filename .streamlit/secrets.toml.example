# Copy this file to .streamlit/secrets.toml (same folder) and fill in real values.
# NEVER commit the real secrets.toml to git / share it - it contains live credentials.
#
# On Streamlit Community Cloud, you don't need this file at all: paste the same
# keys/values into your app's Settings -> Secrets box in the dashboard instead.

ANTHROPIC_API_KEY = "sk-ant-..."

# Where signed consent forms are emailed, as PDF attachments.
#
# app_password is a Gmail App Password, NOT your normal Google password.
# To create one: enable 2-Step Verification on the sending Google account,
# then go to https://myaccount.google.com/apppasswords, create a password
# named e.g. "HP4063", and paste the 16 characters here (spaces are fine).
#
# sender must be the Gmail account the App Password belongs to. recipient can
# be any address.
#
# If this is missing or the send fails, signed forms are written to the local
# signed_consents/ folder instead and the results sheet records why, so no
# consent form is ever lost. Note that on Streamlit Community Cloud that
# fallback folder is wiped whenever the container restarts - email is the
# durable record there, so this block must be set in Settings -> Secrets.
[email]
sender = "you@gmail.com"
app_password = "abcd efgh ijkl mnop"
recipient = "you@gmail.com"

# Service account used for the results Google Sheet. Paste the full contents
# of your Google Cloud service account JSON key here, as a TOML table. The
# Sheet must be shared with the client_email below as an Editor.
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-gcp-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
